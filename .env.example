# ─────────────────────────────────────────────
# Service Marketplace - Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
DOMAIN=localhost

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
POSTGRES_DB=svcmarket
POSTGRES_USER=svcmarket
POSTGRES_PASSWORD=changeme_secure_password_here
DATABASE_URL=postgresql://svcmarket:changeme_secure_password_here@localhost:5432/svcmarket?schema=public

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password_here
REDIS_URL=redis://:changeme_redis_password_here@localhost:6379

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET=changeme_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=changeme_refresh_token_secret_at_least_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth Providers (optional)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Docker
# ─────────────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_TLS_VERIFY=0

# ─────────────────────────────────────────────
# Catalog
# ─────────────────────────────────────────────
CATALOG_PATH=/app/catalog
CATALOG_GIT_REPO=https://github.com/your-org/svcmarket-catalog.git
CATALOG_GIT_BRANCH=main
CATALOG_GIT_TOKEN=

# ─────────────────────────────────────────────
# Monitoring (Optional)
# ─────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password

# ─────────────────────────────────────────────
# TLS / Let's Encrypt
# ─────────────────────────────────────────────
ACME_EMAIL=admin@example.com

# ─────────────────────────────────────────────
# Backup (Optional)
# ─────────────────────────────────────────────
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=svcmarket-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────
ENABLE_KUBERNETES=false
ENABLE_MULTI_NODE=false
ENABLE_GITOPS=true
ENABLE_MARKETPLACE_RATINGS=false

# ─────────────────────────────────────────────
# External References
# ─────────────────────────────────────────────
# Cloudflare Dashboard: https://dash.cloudflare.com/profile/settings
# Cloudflare API Token: Create at https://dash.cloudflare.com/profile/api-tokens