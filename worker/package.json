{
  "name": "@svcmarket/worker",
  "version": "1.0.0",
  "description": "Service Marketplace Cloudflare Worker",
  "private": true,
  "main": "dist/worker.js",
  "types": "dist/worker.d.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc && tsc-alias",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@hono/zod-validator": "^0.2.0",
    "bullmq": "^5.7.0",
    "hono": "^4.2.0",
    "ioredis": "^5.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240801.0",
    "@types/node": "^20.11.0",
    "prisma": "^5.10.0",
    "tsc-alias": "^1.8.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0",
    "wrangler": "^3.40.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}