# ─────────────────────────────────────────────
# Production Environment Variables
# Copy to .env and fill in values
# ─────────────────────────────────────────────

# Domain Configuration
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Frontend URL (Cloudflare Pages or self-hosted)
FRONTEND_URL=https://yourdomain.com
APP_URL=https://api.yourdomain.com

# Database
POSTGRES_DB=service_marketplace
POSTGRES_USER=svcmarket
POSTGRES_PASSWORD=generate_strong_password_here

# Redis
# REDIS_URL=redis://redis:6379  (auto from docker-compose)

# JWT Authentication
JWT_SECRET=generate_64_char_random_string_here
JWT_EXPIRES_IN=7d

# Docker Hub (for CI/CD)
DOCKERHUB_TOKEN=your_dockerhub_access_token_here

# VPS Deployment (for GitHub Actions)
VPS_HOST=your-vps-ip
VPS_USER=root
VPS_SSH_KEY=your_private_ssh_key_here

# Cloudflare (for Pages/Workers deployment)
CLOUDFLARE_API_TOKEN=your_cf_api_token
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id

# Catalog Sync (optional - Git repo with service definitions)
CATALOG_REPO_URL=https://github.com/your-org/service-catalog.git
CATALOG_BRANCH=main
CATALOG_TOKEN=your_github_pat_for_private_repo