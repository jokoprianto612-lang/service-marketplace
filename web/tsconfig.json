{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@svcmarket/shared/*": ["../shared/*"]
    },
    "types": ["vite/client", "react", "react-dom", "react/jsx-runtime", "@react-three/fiber", "@react-three/drei"]
  },
  "include": ["src", "src/**/*", "src/vite-env.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}